# Copy these into Railway's Variables tab for the API service. Never commit real values.

# Solana devnet RPC. The public one works for light testing; a provider key is more reliable.
RPC_URL=https://api.devnet.solana.com

# The deployed burnpad program on devnet (fee split, creator stream and burn vault).
BURNPAD_PROGRAM_ID=9maH9DVCxUd4bjfCNnANW673Xt2YMXaWwQr8UEqAi1ZL

# Public address of this API, used inside token metadata links (for example https://your-api.up.railway.app).
PUBLIC_URL=

# The web page's address, to restrict which site may call this API. Use * while testing.
CORS_ORIGIN=*

# Where the token list and metadata are kept. Attach a Railway volume and point this at it to keep data across deploys.
DATA_DIR=./data
